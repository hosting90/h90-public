#!/bin/bash

# If receive_lsn == replay_lsn, replica has no pending WAL to apply, so it's
# fully caught up regardless of how old pg_last_xact_replay_timestamp() is
# (that timestamp only reflects the last *replayed transaction*, not the
# last sync check - it goes stale when master is idle even though nothing
# is actually behind).
caught_up=$(su - postgres -c "psql -Atc \"select pg_last_wal_receive_lsn() = pg_last_wal_replay_lsn();\"")

if [ "$caught_up" = "t" ]; then
  echo "OK: replica is synced (no pending WAL).|replica_lag=0;1;60;;"
  exit 0
fi

lag=$(su - postgres -c "psql -c 'select extract (epoch from now()-pg_last_xact_replay_timestamp()) as replication_lag;'" | head -n 3 | tail -n 1 | awk '{ print $1 }')


res=$(bc -l <<<"$lag > 60")
if [ $res -eq 1 ]; then
  echo "Critical: replica $lag behind master.|replica_lag=$lag;1;60;;";
  exit 2;
fi;


res=$(bc -l <<<"$lag > 1")
if [ $res -eq 1 ]; then
  echo "Warning: replica $lag behind master.|replica_lag=$lag;1;60;;";
  exit 1;
fi;

res=$(bc -l <<<"$lag < 1")
if [ $res -eq 1 ]; then
  echo "OK: replica is synced: $lag|replica_lag=$lag;1;60;;";
  exit 0;
fi;

echo "Replica lag unknown: $lag|replica_lag=;1;60;;"
exit 3;
